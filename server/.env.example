# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon).
# Get this from the Neon console -> your project -> Connection Details -> Connection string (pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connect_timeout=30"

# Port the API server listens on. The client's VITE_API_BASE_URL must point here.
PORT=3000

# Secret used to sign JWTs. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required, at least 32 characters: the server refuses to start without it.
JWT_SECRET=""

# Server-side pepper for the deterministic PIN lookup hash (see src/lib/pin.ts).
# Lets us find a cashier by PIN in one query instead of bcrypt-comparing every user.
# Generate the same way as JWT_SECRET. If unset, JWT_SECRET is used as the pepper.
# Changing this invalidates every stored PIN -- re-run `npm run seed` or have staff re-enrol.
PIN_PEPPER=""

# Sales tax as a fraction (0.08 = 8%). Optional; defaults to 0.08. The till is
# told this rate by /api/bootstrap and checkout re-derives tax with it.
TAX_RATE=0.08

# Browser origins allowed to call the API, comma-separated. `*` matches one
# hostname label (letters, digits, hyphens), e.g.
#   https://sellkit-pos.vercel.app,https://sellkit-pos-*-myteam.vercel.app
# Unset: every origin in development, none when NODE_ENV=production.
CORS_ORIGINS=""

# Number of proxies in front of the server (1 on Render). Makes req.ip the real
# client so the login rate limiter does not lump everyone together. Leave unset
# when the server is reached directly; never set it higher than the real count,
# or clients can spoof their IP.
TRUST_PROXY=""
