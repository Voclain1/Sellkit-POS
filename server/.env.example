# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon).
# Get this from the Neon console -> your project -> Connection Details -> Connection string (pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connect_timeout=30"

# Port the API server listens on. The client's VITE_API_BASE_URL must point here.
PORT=3000

# Secret used to sign JWTs. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NOTE: src/middleware/auth.ts falls back to a hardcoded literal when this is unset.
# Set it in every environment, and drop that fallback before deploying.
JWT_SECRET=""

# Server-side pepper for the deterministic PIN lookup hash (see src/lib/pin.ts).
# Lets us find a cashier by PIN in one query instead of bcrypt-comparing every user.
# Generate the same way as JWT_SECRET. If unset, JWT_SECRET is used as the pepper.
# Changing this invalidates every stored PIN -- re-run `npm run seed` or have staff re-enrol.
PIN_PEPPER=""
