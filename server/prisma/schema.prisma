// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Roles
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  pin       String?
  name      String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sales               Sale[]
  tillReconciliations TillReconciliation[]
}

// ---------------------------------------------------------------------------
// Outlets & Tills
// ---------------------------------------------------------------------------

model Outlet {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tills Till[]
  sales Sale[]
}

model Till {
  id         String   @id @default(uuid())
  name       String
  /// Short, unique code printed in this till's receipt numbers (e.g. "T01").
  code       String   @unique
  /// Last receipt sequence issued on this till. Incremented inside the checkout
  /// transaction, so receipt numbers are sequential per till with no gaps.
  receiptSeq Int      @default(0)
  outletId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  outlet              Outlet               @relation(fields: [outletId], references: [id])
  sales               Sale[]
  tillReconciliations TillReconciliation[]
}

// ---------------------------------------------------------------------------
// Products, Categories, and ProductVariants
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]
}

model Product {
  id          String    @id @default(uuid())
  categoryId  String
  name        String
  description String?
  /// Set instead of deleting once a product has sales history. Archived
  /// products drop out of the catalogue but their sale lines stay intact.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String? // e.g., "Large", "Red"
  sku           String   @unique
  barcode       String?  @unique
  price         Decimal  @db.Decimal(10, 2)
  cost          Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  product   Product    @relation(fields: [productId], references: [id])
  saleItems SaleItem[]
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sales Sale[]
}

// ---------------------------------------------------------------------------
// Sales, SaleItems, and PaymentSplits
// ---------------------------------------------------------------------------

model Sale {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  totalAmount   Decimal  @db.Decimal(10, 2)
  tax           Decimal  @default(0) @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  isOfflineSync Boolean  @default(false)
  /// Generated by the till before the first POST. A replay of the same sale
  /// (lost response, offline queue retry) finds the existing row instead of
  /// creating a second one.
  clientSaleId  String?  @unique
  /// Set when the server accepted a sale it could not fully verify (an offline
  /// sale that oversold stock, or was rung up at a price that has since changed).
  needsReview   Boolean  @default(false)
  reviewNotes   String?
  /// When the sale happened at the till. For an offline sale this is the time it
  /// was rung up, not the time it reached the server.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign Keys
  userId     String
  outletId   String
  tillId     String
  customerId String?
  shiftId    String?

  // Relations
  user          User                @relation(fields: [userId], references: [id])
  outlet        Outlet              @relation(fields: [outletId], references: [id])
  till          Till                @relation(fields: [tillId], references: [id])
  customer      Customer?           @relation(fields: [customerId], references: [id])
  shift         TillReconciliation? @relation(fields: [shiftId], references: [id])
  saleItems     SaleItem[]
  paymentSplits PaymentSplit[]

  @@index([shiftId])
  @@index([tillId, createdAt])
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  // Relations
  sale           Sale           @relation(fields: [saleId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model PaymentSplit {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)

  // Relations
  sale Sale @relation(fields: [saleId], references: [id])
}

// ---------------------------------------------------------------------------
// Shifts / TillReconciliations
// ---------------------------------------------------------------------------

model TillReconciliation {
  id           String    @id @default(uuid())
  tillId       String
  userId       String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @db.Decimal(10, 2)
  expectedCash Decimal?  @db.Decimal(10, 2)
  actualCash   Decimal?  @db.Decimal(10, 2)
  discrepancy  Decimal?  @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  till  Till   @relation(fields: [tillId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]
}
