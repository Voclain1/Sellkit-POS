// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Roles
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  pin       String?
  name      String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sales              Sale[]
  tillReconciliations TillReconciliation[]
}

// ---------------------------------------------------------------------------
// Outlets & Tills
// ---------------------------------------------------------------------------

model Outlet {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tills     Till[]
  sales     Sale[]
}

model Till {
  id        String   @id @default(uuid())
  name      String
  outletId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  outlet              Outlet               @relation(fields: [outletId], references: [id])
  sales               Sale[]
  tillReconciliations TillReconciliation[]
}

// ---------------------------------------------------------------------------
// Products, Categories, and ProductVariants
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String?  // e.g., "Large", "Red"
  sku           String   @unique
  barcode       String?  @unique
  price         Decimal  @db.Decimal(10, 2)
  cost          Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  product   Product    @relation(fields: [productId], references: [id])
  saleItems SaleItem[]
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sales Sale[]
}

// ---------------------------------------------------------------------------
// Sales, SaleItems, and PaymentSplits
// ---------------------------------------------------------------------------

model Sale {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  totalAmount   Decimal  @db.Decimal(10, 2)
  tax           Decimal  @default(0) @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  isOfflineSync Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign Keys
  userId     String
  outletId   String
  tillId     String
  customerId String?

  // Relations
  user          User           @relation(fields: [userId], references: [id])
  outlet        Outlet         @relation(fields: [outletId], references: [id])
  till          Till           @relation(fields: [tillId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  saleItems     SaleItem[]
  paymentSplits PaymentSplit[]
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  // Relations
  sale           Sale           @relation(fields: [saleId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model PaymentSplit {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)

  // Relations
  sale Sale @relation(fields: [saleId], references: [id])
}

// ---------------------------------------------------------------------------
// Shifts / TillReconciliations
// ---------------------------------------------------------------------------

model TillReconciliation {
  id               String    @id @default(uuid())
  tillId           String
  userId           String
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  openingFloat     Decimal   @db.Decimal(10, 2)
  expectedCash     Decimal?  @db.Decimal(10, 2)
  actualCash       Decimal?  @db.Decimal(10, 2)
  discrepancy      Decimal?  @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  till Till @relation(fields: [tillId], references: [id])
  user User @relation(fields: [userId], references: [id])
}
