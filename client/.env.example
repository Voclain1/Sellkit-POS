# Copy to .env and adjust as needed. Never commit .env.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here -- everything in this file ships to the client.

# Base URL of the Sellkit POS API, including the /api prefix.
# Must match the server's PORT (see server/.env.example).
VITE_API_BASE_URL="http://localhost:3000/api"

# Deployed builds must override this with the live API, e.g.
#   VITE_API_BASE_URL="https://sellkit-pos.onrender.com/api"
#
# .env.* is git-ignored, so a local .env.production does NOT reach Vercel --
# set it in the Vercel project's Environment Variables instead. Vite inlines
# the value at build time, so changing it requires a redeploy, not a restart.
# src/lib/api.ts falls back to the live API if a production build is left
# pointing at localhost.
