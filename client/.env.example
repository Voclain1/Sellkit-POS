# Copy to .env and adjust as needed. Never commit .env.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here -- everything in this file ships to the client.

# Base URL of the Sellkit POS API, including the /api prefix.
# Must match the server's PORT (see server/.env.example).
VITE_API_BASE_URL="http://localhost:3000/api"
